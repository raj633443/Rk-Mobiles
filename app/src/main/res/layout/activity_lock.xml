<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="@color/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="RK MOBILES" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Enter PIN" android:textSize="16sp" android:layout_marginTop="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etPin" android:inputType="numberPassword" android:maxLength="6"
        android:gravity="center" android:textSize="22sp" android:layout_width="180dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnUnlock" android:text="Unlock" android:layout_marginTop="18dp"
        android:layout_width="180dp" android:layout_height="wrap_content"/>
</LinearLayout>
