<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RK MOBILES" android:textColor="@color/rk_dark"
            android:textSize="30sp" android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Business Manager"
            android:textColor="#6B7280" android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Today overview"
            android:textColor="#111827" android:textSize="20sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/card_bg"
            android:lineSpacingExtra="5dp" android:padding="18dp"
            android:text="Loading..." android:textColor="#111827" android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Quick actions"
            android:textColor="#111827" android:textSize="20sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btnStock" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginEnd="6dp"
                android:layout_weight="1" android:backgroundTint="@color/rk_blue"
                android:text="Stock" android:textColor="@color/white" android:textSize="14sp" />
            <Button android:id="@+id/btnRepair" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginStart="6dp"
                android:layout_weight="1" android:backgroundTint="@color/rk_dark"
                android:text="Repairs" android:textColor="@color/white" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btnPending" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginEnd="6dp"
                android:layout_weight="1" android:backgroundTint="@color/pending"
                android:text="Pending" android:textColor="@color/white" android:textSize="14sp" />
            <Button android:id="@+id/btnSale" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginStart="6dp"
                android:layout_weight="1" android:backgroundTint="@color/profit"
                android:text="Add Sale" android:textColor="@color/white" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btnExpense" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginEnd="6dp"
                android:layout_weight="1" android:backgroundTint="#6B7280"
                android:text="Expense" android:textColor="@color/white" android:textSize="14sp" />
            <Button android:id="@+id/btnProfit" android:layout_width="0dp"
                android:layout_height="64dp" android:layout_marginStart="6dp"
                android:layout_weight="1" android:backgroundTint="#7C3AED"
                android:text="Profit &amp; Loss" android:textColor="@color/white" android:textSize="14sp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="12dp"
            android:text="Daily pending reminder • 10:00 AM"
            android:textColor="#6B7280" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
