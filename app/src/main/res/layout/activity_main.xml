<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="RK MOBILES" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/rk_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Business Manager" android:textSize="15sp" android:layout_marginBottom="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvSummary" android:text="Loading..." android:textSize="18sp" android:background="@drawable/card_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
<Button android:id="@+id/btnStock" android:text="Stock" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnRepair" android:text="Repairs" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnPending" android:text="Customer Pending" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnSale" android:text="Add Sale" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnExpense" android:text="Add Expense" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnProfit" android:text="Profit &amp; Loss" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnMoreFeatures" android:text="Business Suite  •  More Features" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:backgroundTint="@color/rk_dark" android:textColor="@color/white"/>
<TextView android:text="Daily pending reminder: 10:00 AM" android:textSize="13sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
