<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RK Mobile Business Suite" android:textColor="@color/rk_dark" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Billing • Stock • Customers • Reports" android:textColor="#6B7280" android:textSize="14sp"/>
<Button android:id="@+id/btnCreateInvoice" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:backgroundTint="@color/rk_blue" android:text="Create Invoice" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnInvoiceHistory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="@color/rk_dark" android:text="Invoice History" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnCustomers" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#334155" android:text="Customers" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnLedger" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#475569" android:text="Customer Ledger &amp; Payments" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnPurchase" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#168A45" android:text="Purchase" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnImeiStock" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#7C3AED" android:text="IMEI / Stock Search" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnStockReport" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#0F766E" android:text="Stock Report" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnFeatureReports" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#374151" android:text="Business Reports" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnBackup" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#92400E" android:text="Backup &amp; Restore" android:textColor="@color/white" android:textStyle="bold"/>
<Button android:id="@+id/btnFeatureSettings" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:backgroundTint="#6B7280" android:text="Business Settings" android:textColor="@color/white" android:textStyle="bold"/>
</LinearLayout>
</ScrollView>