<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="IMEI / Stock Search" android:textColor="@color/rk_dark"
        android:textSize="28sp" android:textStyle="bold"/>
    <EditText android:id="@+id/etImeiSearch" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="18dp" android:background="@drawable/feature_card"
        android:hint="Search IMEI or model" android:padding="14dp" android:singleLine="true"/>
    <Button android:id="@+id/btnSearchImei" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="8dp" android:backgroundTint="@color/rk_blue"
        android:text="SEARCH" android:textColor="@color/white" android:textStyle="bold"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="14dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/imeiResults" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
