<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Add Repair" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etCustomer" android:hint="Customer name" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etPhone" android:hint="Phone" android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etRepairModel" android:hint="Mobile model" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etIssue" android:hint="Issue / work" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etRepairCost" android:hint="Repair cost" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etRepairCharge" android:hint="Customer charge" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnSaveRepair" android:text="Save Repair" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
