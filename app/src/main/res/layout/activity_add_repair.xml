<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Add Repair" android:textColor="@color/rk_dark"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:layout_marginBottom="20dp"
            android:text="Enter repair details" android:textColor="#6B7280"
            android:textSize="14sp" />

        <EditText android:id="@+id/etCustomer" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg" android:hint="Customer name"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" />
        <EditText android:id="@+id/etPhone" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg" android:hint="Phone number"
            android:inputType="phone" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:singleLine="true" />
        <EditText android:id="@+id/etRepairModel" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg" android:hint="Mobile model"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" />
        <EditText android:id="@+id/etIssue" android:layout_width="match_parent"
            android:layout_height="90dp" android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg" android:gravity="top"
            android:hint="Issue / work done" android:padding="16dp" />
        <EditText android:id="@+id/etRepairCost" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg" android:hint="Repair cost"
            android:inputType="numberDecimal" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:singleLine="true" />
        <EditText android:id="@+id/etRepairCharge" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="18dp"
            android:background="@drawable/card_bg" android:hint="Customer charge"
            android:inputType="numberDecimal" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:singleLine="true" />

        <Button android:id="@+id/btnSaveRepair" android:layout_width="match_parent"
            android:layout_height="60dp" android:backgroundTint="@color/rk_blue"
            android:text="SAVE REPAIR" android:textColor="@color/white"
            android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
