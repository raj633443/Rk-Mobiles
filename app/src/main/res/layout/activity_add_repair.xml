<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:background="@color/background"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Add Repair" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/primary"
        android:layout_marginBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etCustomer" android:hint="Customer Name" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etPhone" android:hint="WhatsApp Number (10 digits)" android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etModel" android:hint="Mobile Model" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etType" android:hint="Repair Type" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etTotal" android:hint="Total Amount ₹" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etPaid" android:hint="Paid Amount ₹" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etExpense" android:hint="Repair Expense ₹" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvCalc" android:text="Pending: ₹0   Profit: ₹0" android:textSize="17sp" android:textStyle="bold"
        android:padding="14dp" android:layout_marginTop="10dp" android:background="@drawable/card_bg"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSave" android:text="Save Repair" android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
