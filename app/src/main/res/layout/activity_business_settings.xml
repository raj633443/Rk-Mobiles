<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Business Settings" android:textColor="@color/rk_dark" android:textSize="28sp" android:textStyle="bold"/>
<EditText android:id="@+id/etFirmName" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:hint="Business name" android:background="@drawable/feature_card" android:padding="14dp"/>
<EditText android:id="@+id/etFirmPhone" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:hint="Phone" android:background="@drawable/feature_card" android:padding="14dp"/>
<EditText android:id="@+id/etFirmAddress" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="8dp" android:hint="Address" android:background="@drawable/feature_card" android:padding="14dp"/>
<EditText android:id="@+id/etFirmGstin" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:hint="GSTIN (optional)" android:background="@drawable/feature_card" android:padding="14dp"/>
<EditText android:id="@+id/etInvoicePrefix" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:hint="Invoice prefix" android:background="@drawable/feature_card" android:padding="14dp"/>
<Button android:id="@+id/btnSaveFirm" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:backgroundTint="@color/rk_blue" android:text="SAVE BUSINESS PROFILE" android:textColor="@color/white"/>
</LinearLayout></ScrollView>