<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp"
    android:background="@color/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Stock" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/primary"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etItem" android:hint="Item Name" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etQty" android:hint="Quantity" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etBuy" android:hint="Buy Price ₹" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etSell" android:hint="Sell Price ₹" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnAddStock" android:text="Add Stock" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/listStock" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
