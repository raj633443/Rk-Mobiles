<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Purchase" android:textColor="@color/rk_dark" android:textSize="28sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etSupplier" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="18dp" android:background="@drawable/feature_card" android:hint="Supplier name"
            android:padding="14dp" android:singleLine="true"/>
        <EditText android:id="@+id/etPurchaseItem" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:background="@drawable/feature_card" android:hint="Item / model"
            android:padding="14dp" android:singleLine="true"/>
        <EditText android:id="@+id/etPurchaseQty" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:background="@drawable/feature_card" android:hint="Quantity"
            android:inputType="number" android:padding="14dp" android:singleLine="true"/>
        <EditText android:id="@+id/etPurchaseBuy" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:background="@drawable/feature_card" android:hint="Purchase price"
            android:inputType="numberDecimal" android:padding="14dp" android:singleLine="true"/>
        <EditText android:id="@+id/etPurchaseImei" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:background="@drawable/feature_card" android:hint="IMEI / Serial (optional)"
            android:inputType="phone" android:padding="14dp" android:singleLine="true"/>
        <Button android:id="@+id/btnSavePurchase" android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="14dp" android:backgroundTint="@color/rk_blue"
            android:text="SAVE PURCHASE" android:textColor="@color/white" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
